function [tmap_iv, pmap_iv, df, t_thr] = voxelwiseLM(data_cell, C, st_vec, regnum, nuisance_cell, V_vec)
% VOXELWISELM Voxel-wise linear model across studies with optional row weights.
%
%   [tmap_iv, pmap_iv, df, t_thr] = voxelwiseLM(data_cell, C, st_vec, regnum)
%   [tmap_iv, pmap_iv, df, t_thr] = voxelwiseLM(data_cell, C, st_vec, regnum, nuisance_cell)
%   [tmap_iv, pmap_iv, df, t_thr] = voxelwiseLM(data_cell, C, st_vec, regnum, nuisance_cell, V_vec)
%
% INPUTS
%   data_cell     - 1xS cell, each fmri_data.dat = [V x n_s]
%   C             - 1xS contrast weights for each study
%   st_vec        - vector describing study grouping for design expansion
%   regnum        - column index in the final design matrix to test
%   nuisance_cell - optional 1xS cell, each [n_s x p] covariate matrix
%   V_vec         - optional [N x 1] row weights or logical validity mask
%
% NOTES
%   - If V_vec is logical or binary 0/1, only rows with V_vec == 1 are kept.
%   - Otherwise V_vec is used as nonnegative regression weights in a
%     weighted least-squares fit.

if nargin < 5 || isempty(nuisance_cell)
    nuisance_cell = cell(size(data_cell));
end

if nargin < 6
    V_vec = [];
end

S = numel(data_cell);
assert(numel(C) == S, 'Contrast length must match number of studies');

% 1) Stack data and build regressors
Y = [];   % [N x V]
G = [];   %#ok<NASGU> % study contrast regressor, kept for compatibility
Z = [];   % nuisance regressors
M = [];   % study-specific regressors
M2 = [];  %#ok<NASGU> % retained to preserve prior design-building logic

for s = 1:S
    D = data_cell{s}.dat;   % [V x n_s]
    ns = size(D, 2);

    Y = [Y; D']; %#ok<AGROW>
    G = [G; C(s) * ones(ns, 1)]; %#ok<AGROW>

    Zs = nuisance_cell{s};
    if isempty(Zs)
        Z = [Z; zeros(ns, 0)]; %#ok<AGROW>
    else
        assert(size(Zs, 1) == ns, 'nuisance rows must match subjects');
        Z = [Z; Zs]; %#ok<AGROW>
    end

    Ms = ones(ns, 1);
    M = blkdiag(M, Ms);

    if s == 1
        M2 = Ms;
    else
        cdr = st_vec(s) == st_vec(s - 1);
        if cdr
            nrs = size(M2, 2) - 1;
            M2 = [M2; [zeros(ns, nrs) Ms]]; %#ok<AGROW>
        else
            M2 = blkdiag(M2, Ms);
        end
    end
end

[N, ~] = size(Y);

% 2) Design matrix
% X = [ones(N,1), G, Z, M];
X = [ones(N, 1), Z, M];

studyCols = 2:size(X, 2);
[X, ~] = makeInterceptGrandMean(X, studyCols, 'keepIntercept', true, 'frontRegs', false);

% 3) Optional row filtering / weighting
use_weights = false;
if ~isempty(V_vec)
    V_vec = V_vec(:);
    assert(numel(V_vec) == N, 'V_vec must have one entry per stacked subject row.');
    assert(all(isfinite(V_vec)), 'V_vec must contain finite values only.');
    assert(all(V_vec >= 0), 'V_vec must be nonnegative.');

    is_binary = islogical(V_vec) || all(ismember(unique(V_vec), [0 1]));

    if is_binary
        keep = logical(V_vec);
        X = X(keep, :);
        Y = Y(keep, :);
        N = size(X, 1);
        Wsqrt = [];
    else
        use_weights = true;
        Wsqrt = sqrt(V_vec);
    end
else
    Wsqrt = [];
end

df = N - rank(X);

% 4) OLS / WLS fit for each voxel
if use_weights
    Xw = X .* Wsqrt;
    Yw = Y .* Wsqrt;
    B = double(pinv(Xw) * Yw);

    E = Y - X * B;
    Ew = E .* Wsqrt;
    mse = sum(Ew .^ 2, 1) / df;
    XtX_pinv = pinv(Xw' * Xw);
else
    B = double(pinv(X) * Y);

    E = Y - X * B;
    mse = sum(E .^ 2, 1) / df;
    XtX_pinv = pinv(X' * X);
end

% 5) t-statistics and p-values for the requested regressor
col = regnum;
varB_col = mse .* XtX_pinv(col, col);
tvals = B(col, :) ./ sqrt(varB_col);

report = diagnose_Y_matrix(Y);
pvals = 2 * tcdf(-abs(tvals), df);
[p1, ~] = fdr_benjhoc(pvals);

t_thr(1) = tinv(1 - fdr_benjhoc(tcdf(tvals, df)), df);
t_thr(2) = tinv(1 - fdr_benjhoc(tcdf(-tvals, df)), df);

% 6) Wrap as image_vectors and display
volInfo = data_cell{1}.volInfo;
tmap_iv = image_vector('volInfo', volInfo, 'dat', tvals(:));
pmap_iv = image_vector('volInfo', volInfo, 'dat', pvals(:));

tmpl = image_vector('image_names', 'fmriprep20_template.nii');
tiv_rs = resample_space(tmap_iv, tmpl);

T = tinv(1 - p1, df);
plot_signed_threshold(tiv_rs, T)

end
